# HTTP
PORT=8787
BASE_URL=http://localhost:8787

# mock | btcpay
PAYMENT_PROVIDER=mock

# Paid features are not implemented yet. Keep false until license gating is ready.
PRO_AVAILABLE=false

# BTCPay Server (Greenfield API)
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=

# Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_CHAT_ID=

# Optional admin endpoint: GET /api/admin/orders with Bearer <token>
ADMIN_TOKEN=

# Where orders.json and the generated license keypair are stored
DATA_DIR=./data

# Optional: supply a stable Ed25519 keypair instead of generating one.
# Use \n for line breaks if the value is a single-line PEM.
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=
