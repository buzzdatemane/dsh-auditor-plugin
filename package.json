{
  "name": "dsh-auditor-plugin",
  "version": "0.3.0",
  "description": "Read-only static security auditor for DSH plugins.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "auditor"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "^0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/audit.test.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@types/node": "26.6.6",
    "@types/semver": "7.7.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "semver": "7.7.3"
  }
}
